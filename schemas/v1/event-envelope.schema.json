            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Agentids",
          "type": "array"
        },
        "decisionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Decisionid",
          "type": "string"
        },
        "overrideId": {
          "anyOf": [
            {
              "maxLength": 128,
              "minLength": 1,
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Overrideid"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Requestid",
          "type": "string"
        },
        "type": {
          "const": "squad.authorized",
          "default": "squad.authorized",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "decisionId",
        "agentIds"
      ],
      "title": "SquadAuthorizedPayload",
      "type": "object"
    },
    "SquadOverriddenPayload": {
      "additionalProperties": false,
      "properties": {
        "authorizedAgentIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Authorizedagentids",
          "type": "array"
        },
        "decisionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Decisionid",
          "type": "string"
        },
        "overrideId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Overrideid",
          "type": "string"
        },
        "proposedAgentIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Proposedagentids",
          "type": "array"
        },
        "reasonCode": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Reasoncode",
          "type": "string"
        },
        "reasonHash": {
          "pattern": "^sha256:[0-9a-f]{64}$",
          "title": "Reasonhash",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Requestid",
          "type": "string"
        },
        "type": {
          "const": "squad.overridden",
          "default": "squad.overridden",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "decisionId",
        "overrideId",
        "proposedAgentIds",
        "authorizedAgentIds",
        "reasonCode",
        "reasonHash"
      ],
      "title": "SquadOverriddenPayload",
      "type": "object"
    },
    "SquadProposedPayload": {
      "additionalProperties": false,
      "properties": {
        "agentIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "minItems": 1,
          "title": "Agentids",
          "type": "array"
        },
        "decisionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Decisionid",
          "type": "string"
        },
        "requestId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Requestid",
          "type": "string"
        },
        "selector": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Selector",
          "type": "string"
        },
        "type": {
          "const": "squad.proposed",
          "default": "squad.proposed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "requestId",
        "decisionId",
        "agentIds",
        "selector"
      ],
      "title": "SquadProposedPayload",
      "type": "object"
    },
    "SynthesisCompletedPayload": {
      "additionalProperties": false,
      "properties": {
        "answer": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Answer",
          "type": "string"
        },
        "citationNumbers": {
          "default": [],
          "items": {
            "type": "integer"
          },
          "title": "Citationnumbers",
          "type": "array"
        },
        "type": {
          "const": "synthesis.completed",
          "default": "synthesis.completed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "answer"
      ],
      "title": "SynthesisCompletedPayload",
      "type": "object"
    },
    "TaskCompletedPayload": {
      "additionalProperties": false,
      "properties": {
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "summary": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "taskId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Taskid",
          "type": "string"
        },
        "type": {
          "const": "task.completed",
          "default": "task.completed",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "status",
        "summary"
      ],
      "title": "TaskCompletedPayload",
      "type": "object"
    },
    "TaskHandedOffPayload": {
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Agentid",
          "type": "string"
        },
        "callbackModes": {
          "items": {
            "$ref": "#/$defs/CallbackMode"
          },
          "title": "Callbackmodes",
          "type": "array"
        },
        "taskId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Taskid",
          "type": "string"
        },
        "type": {
          "const": "task.handed_off",
          "default": "task.handed_off",
          "title": "Type",
          "type": "string"
        }
      },
      "required": [
        "taskId",
        "agentId",
        "callbackModes"
      ],
      "title": "TaskHandedOffPayload",
      "type": "object"
    },
    "TaskStatus": {
      "enum": [
        "pending",
        "running",
        "waiting_approval",
        "completed",
        "failed",
        "cancelled"
      ],
      "title": "TaskStatus",
      "type": "string"
    },
    "TransportProtocol": {
      "enum": [
        "a2a",
        "work_iq",
        "mcp"
      ],
      "title": "TransportProtocol",
      "type": "string"
    }
  },
  "$id": "https://schemas.agent-iq.dev/v1/event-envelope.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "eventId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Eventid",
      "type": "string"
    },
    "executionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Executionid",
      "type": "string"
    },
    "occurredAt": {
      "format": "date-time",
      "title": "Occurredat",
      "type": "string"
    },
    "payload": {
      "discriminator": {
        "mapping": {
          "agents.selected": "#/$defs/AgentsSelectedPayload",
          "approval.requested": "#/$defs/ApprovalRequestedPayload",
          "approval.resolved": "#/$defs/ApprovalResolvedPayload",
          "candidates.ranked": "#/$defs/CandidatesRankedPayload",
          "catalog.searched": "#/$defs/CatalogSearchedPayload",
          "evidence.received": "#/$defs/EvidenceReceivedPayload",
          "execution.completed": "#/$defs/ExecutionCompletedPayload",
          "invocation.completed": "#/$defs/InvocationCompletedPayload",
          "invocation.delta": "#/$defs/InvocationDeltaPayload",
          "invocation.failed": "#/$defs/InvocationFailedPayload",
          "invocation.started": "#/$defs/InvocationStartedPayload",
          "plan.prepared": "#/$defs/PlanPreparedPayload",
          "request.accepted": "#/$defs/RequestAcceptedPayload",
          "squad.authorized": "#/$defs/SquadAuthorizedPayload",
          "squad.overridden": "#/$defs/SquadOverriddenPayload",
          "squad.proposed": "#/$defs/SquadProposedPayload",
          "synthesis.completed": "#/$defs/SynthesisCompletedPayload",
          "task.completed": "#/$defs/TaskCompletedPayload",
          "task.handed_off": "#/$defs/TaskHandedOffPayload"
        },
        "propertyName": "type"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/RequestAcceptedPayload"
        },
        {
          "$ref": "#/$defs/CatalogSearchedPayload"
        },
        {
          "$ref": "#/$defs/CandidatesRankedPayload"
        },
        {
          "$ref": "#/$defs/AgentsSelectedPayload"
        },
        {
          "$ref": "#/$defs/SquadProposedPayload"
        },
        {
          "$ref": "#/$defs/SquadOverriddenPayload"
        },
        {
          "$ref": "#/$defs/SquadAuthorizedPayload"
        },
        {
          "$ref": "#/$defs/PlanPreparedPayload"
        },
        {
          "$ref": "#/$defs/ApprovalRequestedPayload"
        },
        {
          "$ref": "#/$defs/ApprovalResolvedPayload"
        },
        {
          "$ref": "#/$defs/InvocationStartedPayload"
        },
        {
          "$ref": "#/$defs/InvocationDeltaPayload"
        },
        {
          "$ref": "#/$defs/EvidenceReceivedPayload"
        },
        {
          "$ref": "#/$defs/InvocationCompletedPayload"
        },
        {
          "$ref": "#/$defs/InvocationFailedPayload"
        },
        {
          "$ref": "#/$defs/SynthesisCompletedPayload"
        },
        {
          "$ref": "#/$defs/TaskHandedOffPayload"
        },
        {
          "$ref": "#/$defs/TaskCompletedPayload"
        },
        {
          "$ref": "#/$defs/ExecutionCompletedPayload"
        }
      ],
      "title": "Payload"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sequence": {
      "minimum": 0,
      "title": "Sequence",
      "type": "integer"
    },
    "traceId": {
      "anyOf": [
        {
          "maxLength": 512,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Traceid"
    }
  },
  "required": [
    "eventId",
    "executionId",
    "sequence",
    "occurredAt",
    "payload"
  ],
  "title": "EventEnvelope",
  "type": "object"
}
