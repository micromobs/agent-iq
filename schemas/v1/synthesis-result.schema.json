{
  "$defs": {
    "Citation": {
      "additionalProperties": false,
      "properties": {
        "evidenceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidenceid",
          "type": "string"
        },
        "label": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Label",
          "type": "string"
        },
        "number": {
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "url": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Url"
        }
      },
      "required": [
        "number",
        "evidenceId",
        "label"
      ],
      "title": "Citation",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "agentIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Agentids",
          "type": "array"
        },
        "claimId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Claimid",
          "type": "string"
        },
        "conflict": {
          "default": false,
          "title": "Conflict",
          "type": "boolean"
        },
        "evidenceIds": {
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
            "type": "string"
          },
          "title": "Evidenceids",
          "type": "array"
        },
        "text": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [
        "claimId",
        "text",
        "evidenceIds",
        "agentIds"
      ],
      "title": "Claim",
      "type": "object"
    },
    "EvidenceBundle": {
      "additionalProperties": false,
      "properties": {
        "citations": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Citation"
          },
          "title": "Citations",
          "type": "array"
        },
        "claims": {
          "default": [],
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "title": "Claims",
          "type": "array"
        },
        "executionId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Executionid",
          "type": "string"
        },
        "records": {
          "items": {
            "$ref": "#/$defs/EvidenceRecord"
          },
          "title": "Records",
          "type": "array"
        },
        "schemaVersion": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schemaversion",
          "type": "string"
        }
      },
      "required": [
        "executionId",
        "records"
      ],
      "title": "EvidenceBundle",
      "type": "object"
    },
    "EvidenceLocator": {
      "additionalProperties": false,
      "properties": {
        "documentKey": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Documentkey"
        },
        "section": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Section"
        },
        "uri": {
          "anyOf": [
            {
              "format": "uri",
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Uri"
        }
      },
      "title": "EvidenceLocator",
      "type": "object"
    },
    "EvidenceRecord": {
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Agentid",
          "type": "string"
        },
        "confidence": {
          "anyOf": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "contentHash": {
          "anyOf": [
            {
              "pattern": "^sha256:[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contenthash"
        },
        "evidenceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Evidenceid",
          "type": "string"
        },
        "excerpt": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Excerpt",
          "type": "string"
        },
        "invocationId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Invocationid",
          "type": "string"
        },
        "knowledgeSource": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Knowledgesource"
        },
        "localReferenceId": {
          "anyOf": [
            {
              "maxLength": 512,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Localreferenceid"
        },
        "locator": {
          "$ref": "#/$defs/EvidenceLocator"
        },
        "retrievedAt": {
          "format": "date-time",
          "title": "Retrievedat",
          "type": "string"
        },
        "sourceId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Sourceid",
          "type": "string"
        },
        "title": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "evidenceId",
        "invocationId",
        "agentId",
        "sourceId",
        "title",
        "locator",
        "excerpt",
        "retrievedAt"
      ],
      "title": "EvidenceRecord",
      "type": "object"
    },
    "GroundingCoverage": {
      "additionalProperties": false,
      "properties": {
        "groundedClaims": {
          "minimum": 0,
          "title": "Groundedclaims",
          "type": "integer"
        },
        "ratio": {
          "maximum": 1,
          "minimum": 0,
          "title": "Ratio",
          "type": "number"
        },
        "totalClaims": {
          "minimum": 0,
          "title": "Totalclaims",
          "type": "integer"
        }
      },
      "required": [
        "totalClaims",
        "groundedClaims",
        "ratio"
      ],
      "title": "GroundingCoverage",
      "type": "object"
    },
    "SynthesisIssue": {
      "additionalProperties": false,
      "properties": {
        "agentId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Agentid",
          "type": "string"
        },
        "message": {
          "maxLength": 16384,
          "minLength": 1,
          "title": "Message",
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/SynthesisIssueStatus"
        }
      },
      "required": [
        "agentId",
        "status",
        "message"
      ],
      "title": "SynthesisIssue",
      "type": "object"
    },
    "SynthesisIssueStatus": {
      "enum": [
        "declined",
        "failed",
        "timed_out",
        "cancelled",
        "omitted_ungrounded"
      ],
      "title": "SynthesisIssueStatus",
      "type": "string"
    },
    "SynthesisStatus": {
      "enum": [
        "complete",
        "partial",
        "declined"
      ],
      "title": "SynthesisStatus",
      "type": "string"
    }
  },
  "$id": "https://schemas.agent-iq.dev/v1/synthesis-result.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "answer": {
      "maxLength": 16384,
      "minLength": 1,
      "title": "Answer",
      "type": "string"
    },
    "conflictClaimIds": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
        "type": "string"
      },
      "title": "Conflictclaimids",
      "type": "array"
    },
    "coverage": {
      "$ref": "#/$defs/GroundingCoverage"
    },
    "evidence": {
      "$ref": "#/$defs/EvidenceBundle"
    },
    "executionId": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
      "title": "Executionid",
      "type": "string"
    },
    "issues": {
      "default": [],
      "items": {
        "$ref": "#/$defs/SynthesisIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "schemaVersion": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schemaversion",
      "type": "string"
    },
    "sourcesMarkdown": {
      "anyOf": [
        {
          "maxLength": 16384,
          "minLength": 1,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Sourcesmarkdown"
    },
    "status": {
      "$ref": "#/$defs/SynthesisStatus"
    }
  },
  "required": [
    "executionId",
    "status",
    "answer",
    "evidence",
    "coverage"
  ],
  "title": "SynthesisResult",
  "type": "object"
}
