{
  "$defs": {
    "SapDemandFact": {
      "additionalProperties": false,
      "properties": {
        "market": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Market",
          "type": "string"
        },
        "periodEnd": {
          "format": "date",
          "title": "Periodend",
          "type": "string"
        },
        "periodStart": {
          "format": "date",
          "title": "Periodstart",
          "type": "string"
        },
        "productId": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$",
          "title": "Productid",
          "type": "string"
        },
        "quantity": {
          "minimum": 0,
          "title": "Quantity",
          "type": "number"
        },
        "reference": {
          "$ref": "#/$defs/SapObjectReference"
        },
        "resourceKind": {
          "const": "demand_fact",
          "default": "demand_fact",
          "title": "Resourcekind",
          "type": "string"
        },
        "unit": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "productId",
        "market",
        "periodStart",
        "periodEnd",
        "quantity",
        "unit",
        "reference"
      ],
      "title": "SapDemandFact",
      "type": "object"
    },
    "SapInventoryPosition": {
