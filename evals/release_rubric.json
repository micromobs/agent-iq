{
  "schemaVersion": "1.0",
  "suiteId": "agent-iq-release-replay",
  "rubric": {
    "schemaVersion": "1.0",
    "rubricId": "agent-iq-release",
    "version": "1.0.0",
    "title": "Agent IQ release rubric",
    "description": "Deterministic release gates plus additive model-judge criteria for sanitized transcript and trace replay.",
    "passThreshold": 0.95,
    "criteria": [
      {
        "criterionId": "routing-exact",
        "dimension": "routing",
        "mode": "deterministic",
        "evaluator": "routing_exact",
        "description": "The selected agent set exactly matches the labelled set.",
        "weight": 1.0,
        "threshold": 1.0,
        "required": true
      },
      {
        "criterionId": "orchestration-exact",
        "dimension": "orchestration",
        "mode": "deterministic",
        "evaluator": "orchestration_exact",
        "description": "The selected agents and dependency graph exactly match the labelled DAG.",
        "weight": 1.0,
        "threshold": 1.0,
        "required": true
      },
      {
        "criterionId": "grounded-claims",
        "dimension": "groundedness",
        "mode": "deterministic",
        "evaluator": "grounded_claims",
        "description": "Every applicable factual claim is backed by structured evidence.",
        "weight": 1.0,
        "threshold": 1.0,
        "required": true
      },
      {
        "criterionId": "evidence-coverage",
        "dimension": "evidence_coverage",
        "mode": "deterministic",
        "evaluator": "evidence_coverage",
        "description": "Expected evidence is present and every expected record is cited.",
        "weight": 1.0,
        "threshold": 1.0,
        "required": true
      },
      {
        "criterionId": "honest-decline",
        "dimension": "honest_decline",
        "mode": "deterministic",
        "evaluator": "honest_decline",
        "description": "The response answers or declines according to the labelled evidence boundary.",
        "weight": 1.0,
        "threshold": 1.0,
        "required": true
      },
      {
        "criterionId": "conflict-visible",
        "dimension": "conflict_handling",
        "mode": "deterministic",
        "evaluator": "conflict_visible",
        "description": "Expected conflicts remain visible and conflict-free cases do not invent one.",
        "weight": 1.0,
        "threshold": 1.0,
        "required": true
      },
      {
        "criterionId": "response-completeness",
        "dimension": "completeness",
        "mode": "deterministic",
        "evaluator": "response_completeness",
        "description": "Required answer elements and outputs are present and forbidden content is absent.",
        "weight": 1.0,
        "threshold": 1.0,
        "required": true
      },
      {
        "criterionId": "task-success",
        "dimension": "task_success",
        "mode": "deterministic",
        "evaluator": "task_success",
        "description": "Terminal status and visible failures exactly match the labelled outcome.",
        "weight": 1.0,
        "threshold": 1.0,
        "required": true
      },
      {
        "criterionId": "answer-quality-judge",
        "dimension": "completeness",
        "mode": "model_judge",
        "evaluator": "answer_quality_v1",
        "description": "A configured judge scores clarity and decision usefulness from the sanitized answer.",
        "weight": 0.5,
        "threshold": 0.8,
        "required": true
      },
      {
        "criterionId": "task-adherence-judge",
        "dimension": "task_success",
        "mode": "model_judge",
        "evaluator": "task_adherence_v1",
        "description": "A configured judge scores whether the sanitized answer addresses the labelled task.",
        "weight": 0.5,
        "threshold": 0.8,
        "required": true
      }
    ]
  },
