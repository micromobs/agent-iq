    {
      "agentId": "consumer-brand-to-brand-compare",
      "knowledgeBindingId": "consumer-product-innovation-kb",
      "promptAddendum": "You specialise in TWO-brand, side-by-side comparisons. Retrieve each brand independently before comparing them. Then present a concise side-by-side across shared dimensions and preserve every citation. If grounded evidence is missing for either brand, say so for that side.",
      "tools": [
        {
          "descriptor": {
            "authorizationScopes": [
              "foundry-iq:consumer-product-innovation-kb:read"
            ],
            "backend": "foundry_iq",
            "description": "Retrieve a grounded profile for one brand before making a comparison.",
            "name": "Retrieve brand profile",
            "parameters": [
              {
                "description": "Brand or product name.",
                "parameterId": "brand"
              },
              {
                "description": "Market or region for the profile.",
                "parameterId": "market"
              }
            ],
            "toolId": "retrieve_brand_profile"
          },
          "queryTemplate": "Grounded brand profile for {brand} in {market}"
        },
        {
          "descriptor": {
            "authorizationScopes": [
              "foundry-iq:consumer-product-innovation-kb:read"
            ],
            "backend": "foundry_iq",
            "description": "Compare one explicit product dimension across two brands.",
            "name": "Compare brand dimension",
            "parameters": [
              {
                "description": "First brand or product.",
                "parameterId": "brand_a"
              },
              {
                "description": "Second brand or product.",
                "parameterId": "brand_b"
              },
              {
                "description": "Shared comparison dimension.",
                "parameterId": "dimension"
              }
            ],
            "toolId": "compare_brand_dimension"
          },
          "queryTemplate": "Compare {brand_a} versus {brand_b} only on {dimension}"
        },
        {
          "descriptor": {
            "authorizationScopes": [
              "foundry-iq:consumer-product-innovation-kb:read"
            ],
            "backend": "foundry_iq",
            "description": "Retrieve the governed method and dimensions for a category comparison.",
            "name": "Retrieve comparison method",
            "parameters": [
              {
                "description": "Product category to compare.",
                "parameterId": "category"
              }
            ],
            "toolId": "retrieve_comparison_method"
          },
          "queryTemplate": "Brand-to-brand comparison method for {category}"
        }
      ]
    },
