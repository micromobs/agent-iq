      "knowledgeBindingId": "consumer-product-innovation-kb",
      "promptAddendum": "For a request about one named product, use only single-product tools. Use compare_active_systems only when the request explicitly asks to compare two named products. In a two-product comparison, retrieve and cite both named product sources, keep a distinct [ref_id:n] marker for each product, and omit comparison-method evidence unless the answer actually relies on it. Never broaden a single-product answer with competitor, brand-comparison, or comparison-method context.",
      "tools": [
        {
          "descriptor": {
            "authorizationScopes": [
              "foundry-iq:consumer-product-innovation-kb:read"
            ],
            "backend": "foundry_iq",
            "description": "Retrieve grounded formula components for a specific performance goal.",
            "name": "Retrieve formula components",
            "parameters": [
              {
                "description": "Product or formula name.",
                "parameterId": "product"
              },
              {
                "description": "Requested performance goal.",
                "parameterId": "performance_goal"
              }
            ],
            "toolId": "retrieve_formula_components"
          },
          "queryTemplate": "For {product} only, what formula components directly support {performance_goal}? Retrieve the smallest sufficient source set directly about {product}. Exclude competitor products, brand comparisons, and comparison-method documents. Include exact source titles and [ref_id:n] citation markers."
        },
