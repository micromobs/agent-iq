AGENT_IQ_ENVIRONMENT=local
AGENT_IQ_NATIVE_A2A_REQUIRED=true
AGENT_IQ_ALLOW_ANONYMOUS_CONNECTOR=false
AGENT_IQ_LOG_LEVEL=INFO

# Set non-secret Azure coordinates only when using a live development target.
AGENT_IQ_FOUNDRY_PROJECT_ENDPOINT=
AGENT_IQ_AZURE_OPENAI_ENDPOINT=
AGENT_IQ_AZURE_EMBEDDING_DEPLOYMENT=
AGENT_IQ_AZURE_EMBEDDING_API_VERSION=2024-10-21
AGENT_IQ_AZURE_MODEL_DEPLOYMENT=
AGENT_IQ_SEARCH_SERVICE=
AGENT_IQ_PUBLIC_BASE_URL=
AGENT_IQ_SAP_MODE=disabled
AGENT_IQ_MEMORY_MODE=disabled
AGENT_IQ_MEMORY_ENDPOINT=http://127.0.0.1:8077/api/v1
AGENT_IQ_MEMORY_TIMEOUT_SECONDS=2

# Use AGENT_IQ_SAP_MODE=fixture only for conspicuously labelled deterministic demos.
# Fixture mode is rejected when AGENT_IQ_ENVIRONMENT=production.
# Set AGENT_IQ_MEMORY_MODE=optional or required to enable the endpoint. Keep
# AGENT_IQ_MEMORY_API_KEY in the process environment or a secret store, never this file.

# Credentials are intentionally omitted. Use Entra/managed identity whenever
# possible. If a service requires AZURE_API_KEY, set it in the process environment.
